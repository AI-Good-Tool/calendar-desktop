{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云小历",
  "version": "0.1.4",
  "identifier": "com.yunxiaoli.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "云小历",
        "width": 900,
        "height": 606,
        "minWidth": 900,
        "minHeight": 562,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "macOS": {
      "files": {
        "Resources/zh-Hans.lproj/InfoPlist.strings": "./locales/zh-Hans.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "./locales/en.lproj/InfoPlist.strings"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QUQ4Q0ZDQ0U1NjZCODIKUldTQ2ExYk8vSXl0OUxzT2pJNTZ1RDllK1dUTjdYQ0s5SHBQOElibi9wL2wwSHI1RmovdGw3U2cK",
      "endpoints": [
        "https://github.com/AI-Good-Tool/calendar-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
